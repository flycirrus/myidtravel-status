# Diese 4 Werte in Vercel als Environment Variables eintragen
# (Project → Settings → Environment Variables). NICHT ins Git committen.

# Basis-URL des VM-Dashboards (läuft bereits auf der Hetzner-VM, Port 8099)
VM_BASE=http://178.105.81.13:8099

# Basic-Auth des VM-Dashboards (aus der VM-/home/hype/myidtravel/.env)
DASH_USER=larry
DASH_PASS=DEIN_VM_DASHBOARD_PASSWORT

# Eigenes Passwort NUR für diese Vercel-App (frei wählbar, schützt die Webseite)
APP_PASSWORD=WÄHLE_EIN_PASSWORT
